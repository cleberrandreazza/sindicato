# --- Frontend (Vite / Vercel) ---
# URL HTTPS do deployment Convex deste ambiente.
# Local: preenchida automaticamente em `.env.local` ao executar `pnpm dev:convex`.
# Demonstração na Vercel: https://coordinated-mink-914.convex.cloud
# Nunca coloque segredos em variáveis VITE_* (vão para o bundle do navegador).
VITE_CONVEX_URL=

# Opcional e NÃO versionado: .env.demo.local com CONVEX_DEPLOY_KEY do projeto sindicato-demo
# para atualizar o Convex de demonstração sem alterar o .env.local de desenvolvimento:
#   pnpm exec convex deploy --env-file .env.demo.local


# VITE_CONVEX_SITE_URL não é usada pelo código desta aplicação (o CLI Convex pode gravá-la
# no .env.local; não precisa ser definida na Vercel).

# --- Backend (Convex) ---
# NÃO são lidas deste arquivo: vivem no deployment Convex.
# Deployment NOVO = zero variáveis → lookup falha com MemberProvider "configuration".
# Configure com `pnpm exec convex env set NOME valor` (checklist no README e
# docs/deployment-guide.md).
#
# APP_ENV=development             # local: habilita mocks
# APP_ENV=demonstration           # Convex de demonstração hospedada: habilita mocks (dados fictícios)
#                                 # qualquer outro valor (ex.: production) RECUSA mocks
# CPF_HASH_SECRET=                # segredo (>= 16 caracteres) para o HMAC do CPF
# OPERATION_TOKEN_SECRET=         # segredo (>= 32 caracteres) para derivar o accessToken (idempotência)
# OPERATION_TOKEN_SECRET_PREVIOUS= # opcional: segredo anterior durante a rotação
# MEMBER_PROVIDER=mock            # mock | (futuro) <integração real>
# PAYMENT_PROVIDER=mock           # mock | (futuro) stripe
# NOTIFICATION_PROVIDER=mock      # mock | (futuro) <e-mail/WhatsApp reais>
